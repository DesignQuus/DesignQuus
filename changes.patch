- ShelfScene에 AlignGuide 컴포넌트 추가 (정렬 버튼 클릭 시 700ms 녹색 기준선 표시)
- ShelfModel XZ 드래그 
- 
- https://claude.ai/code/session_01JYGVwYtjzVkDmqJg3fCJ1H
---
 src/components/ShelfModel.jsx | 9 +++++++--
 src/components/ShelfScene.jsx | 4 ++++
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/components/ShelfModel.jsx b/src/components/ShelfModel.jsx
index 078a206..db67faf 100644
--- a/src/components/ShelfModel.jsx
+++ b/src/components/ShelfModel.jsx
@@ -120,8 +120,13 @@ export default function ShelfModel({ shelfConfig, isActive = true, posX = 0, pos
       if (shelfDragRef.current) {
         if (raycaster.ray.intersectPlane(dragPlane, dragTarget)) {
-          const dx = (dragTarget.x - shelfDragRef.current.startX) * 100
-          const dz = (dragTarget.z - shelfDragRef.current.startZ) * 100
+          let dx = (dragTarget.x - shelfDragRef.current.startX) * 100
+          let dz = (dragTarget.z - shelfDragRef.current.startZ) * 100
+          if (e.ctrlKey) {
+            const SNAP = 27.5
+            dx = Math.round(dx / SNAP) * SNAP
+            dz = Math.round(dz / SNAP) * SNAP
+          }
           setShelfOffset(shelfId, shelfDragRef.current.initOffX + dx, shelfDragRef.current.initOffZ + dz)
         }
         return
diff --git a/src/components/ShelfScene.jsx b/src/components/ShelfScene.jsx
index 2fb13d3..c5e1d90 100644
--- a/src/components/ShelfScene.jsx
+++ b/src/components/ShelfScene.jsx
@@ -9,6 +9,7 @@ import useShelfStore from '../store/useShelfStore.js'
 import useDevStore, { isDev } from '../store/useDevStore.js'
 import DevMeasure from './dev/DevMeasure.jsx'
 import DevDimOverall from './dev/DevDimOverall.jsx'
+import AlignGuide from './AlignGuide.jsx'
 
 function SceneInner({ cameraRef, controlsRef, screenshotRef }) {
@@ -126,6 +127,9 @@ function SceneInner({ cameraRef, controlsRef, screenshotRef }) {
       )
     })()}
 
+      {/* 정렬 가이쓜 라인 (정렬 버튼 클릭 시 0.7초간 표시) */}
+      <AlignGuide />
+
       {{/* DEV: edge-to-edge measurement lines */}
       {isDev && <DevMeasure />}
  
